---
import { getCollection } from 'astro:content';
import SiteShell from '../../layouts/SiteShell.astro';
import StatusPill from '../../components/StatusPill.astro';
import { compareFirstSeenDesc, packageMeta } from '../../data/packageMeta';
import { importanceOrder } from '../../data/research';

const packages = (await getCollection('packages')).sort(
	(a, b) =>
		compareFirstSeenDesc(a.data.firstSeen, b.data.firstSeen)
		|| importanceOrder[a.data.importance] - importanceOrder[b.data.importance],
);
---

<SiteShell
	title="Packages"
	eyebrow="By package"
	intro="Dense inventory view: versions, timing, purpose, and direct links out to package pages, repos, and inspected code."
>
	<section class="section">
		<div class="table-wrap">
			<table class="dense-table">
				<thead>
					<tr>
						<th>First seen</th>
						<th>Package</th>
						<th>Inspected</th>
						<th>Latest stable</th>
						<th>Status</th>
						<th>Summary</th>
						<th>Links</th>
					</tr>
				</thead>
				<tbody>
					{packages.map((entry) => {
						const meta = packageMeta[entry.id] ?? {};
						return (
							<tr>
								<td class="mono">{entry.data.firstSeen}</td>
								<td>
									<a href={`/packages/${entry.id}`}>{entry.data.packageName}</a>
									<div class="table-subtle">{entry.data.kind}</div>
								</td>
								<td class="mono">{meta.inspectedVersion ?? '-'}</td>
								<td>
									<div class="mono">{meta.latestReleaseVersion ?? '-'}</div>
									{meta.latestReleasePublishedAt && <div class="table-subtle">{meta.latestReleasePublishedAt.slice(0, 10)}</div>}
								</td>
								<td><StatusPill status={entry.data.status} /></td>
								<td>
									<div>{entry.data.summary}</div>
									{meta.latestReleaseFeatured && meta.latestReleaseSummary && <div class="table-subtle">{meta.latestReleaseSummary}</div>}
								</td>
								<td>
									<div class="table-links">
										{meta.registryUrl && <a href={meta.registryUrl} target="_blank" rel="noreferrer">{meta.registryLabel ?? 'registry'}</a>}
										{meta.latestReleaseUrl && meta.latestReleaseUrl !== meta.registryUrl && <a href={meta.latestReleaseUrl} target="_blank" rel="noreferrer">latest</a>}
										{meta.repoUrl && <a href={meta.repoUrl} target="_blank" rel="noreferrer">repo</a>}
										{meta.codeUrl && <a href={meta.codeUrl} target="_blank" rel="noreferrer">code</a>}
									</div>
								</td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	</section>
</SiteShell>
