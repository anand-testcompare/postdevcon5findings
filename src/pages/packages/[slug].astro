---
import { getCollection, render } from 'astro:content';
import SiteShell from '../../layouts/SiteShell.astro';
import StatusPill from '../../components/StatusPill.astro';
import { packageMeta } from '../../data/packageMeta';

export async function getStaticPaths() {
	const packages = await getCollection('packages');
	return packages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const seams = await getCollection('seams');
const meta = packageMeta[entry.id] ?? {};

const relatedSeams = seams.filter((item) => entry.data.seamIds.includes(item.id));
---

<SiteShell title={entry.data.title} eyebrow="Package" intro={entry.data.summary} description={entry.data.summary}>
	<section class="section">
		<div class="package-meta-grid">
			<div class="metric compact-metric package-metric">
				<span class="table-subtle">package</span>
				<strong class="metric-code">{entry.data.packageName}</strong>
			</div>
			<div class="metric compact-metric">
				<span class="table-subtle">first seen</span>
				<strong class="metric-code">{entry.data.firstSeen}</strong>
			</div>
			<div class="metric compact-metric">
				<span class="table-subtle">inspected version</span>
				<strong class="metric-code">{meta.inspectedVersion ?? '-'}</strong>
			</div>
			<div class="metric compact-metric">
				<span class="table-subtle">latest stable</span>
				<strong class="metric-code">{meta.latestReleaseVersion ?? '-'}</strong>
			</div>
			<div class="metric compact-metric">
				<span class="table-subtle">status</span>
				<div><StatusPill status={entry.data.status} /></div>
			</div>
		</div>
		<div class="table-links top-links">
			{meta.registryUrl && <a href={meta.registryUrl} target="_blank" rel="noreferrer">{meta.registryLabel ?? 'registry'}</a>}
			{meta.latestReleaseUrl && meta.latestReleaseUrl !== meta.registryUrl && <a href={meta.latestReleaseUrl} target="_blank" rel="noreferrer">latest release</a>}
			{meta.repoUrl && <a href={meta.repoUrl} target="_blank" rel="noreferrer">repo</a>}
			{meta.codeUrl && <a href={meta.codeUrl} target="_blank" rel="noreferrer">code</a>}
		</div>
		{meta.latestReleaseSummary && (
			<div class="list-card release-callout">
				<strong>Latest release signal</strong>
				<div>{meta.latestReleaseVersion} · {meta.latestReleasePublishedAt?.slice(0, 10)}</div>
				<div>{meta.latestReleaseSummary}</div>
			</div>
		)}
		<ul class="plain-list compact-list">
			{entry.data.keyTakeaways.map((item: string) => <li class="list-card">{item}</li>)}
			{meta.notes?.map((item) => <li class="list-card">{item}</li>)}
		</ul>
	</section>

	{meta.codeSnippet && (
		<section class="section">
			<div class="section-header">
				<div>
					<p class="eyebrow">Relevant code</p>
					<h2>Most revealing snippet</h2>
				</div>
				{meta.codeUrl && <a class="link-arrow" href={meta.codeUrl} target="_blank" rel="noreferrer">Open source file -></a>}
			</div>
			{meta.codePath && <p class="table-subtle">{meta.codePath}</p>}
			<pre><code>{meta.codeSnippet}</code></pre>
		</section>
	)}

	<section class="section">
		<div class="section-header">
			<div>
				<p class="eyebrow">Notes</p>
				<h2>What changed</h2>
			</div>
		</div>
		<div class="prose">
			<Content />
		</div>
	</section>

	{relatedSeams.length > 0 && (
		<section class="section">
			<div class="section-header">
				<div>
					<p class="eyebrow">Seams</p>
					<h2>Boundary notes</h2>
				</div>
			</div>
			<div class="card-grid">
				{relatedSeams.map((item) => (
					<article class="card span-6">
						<StatusPill status={item.data.status} />
						<h3>{item.data.title}</h3>
						<p>{item.data.summary}</p>
						<p><a class="link-arrow" href={`/seams/${item.id}`}>Inspect seam -></a></p>
					</article>
				))}
			</div>
		</section>
	)}
</SiteShell>
