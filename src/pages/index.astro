---
import { getCollection } from 'astro:content';
import SiteShell from '../layouts/SiteShell.astro';
import StatusPill from '../components/StatusPill.astro';
import { importanceOrder } from '../data/research';
import { compareFirstSeenDesc, packageMeta } from '../data/packageMeta';

const packages = (await getCollection('packages')).sort(
	(a, b) =>
		compareFirstSeenDesc(a.data.firstSeen, b.data.firstSeen)
		|| importanceOrder[a.data.importance] - importanceOrder[b.data.importance],
);
const seams = await getCollection('seams');
const recentPackages = packages.slice(0, 5);
---

<SiteShell
	title="Post-DevCon 5 Findings"
	description="A research atlas of Palantir's public OSDK, compiler, and private-boundary signals."
	showHero={false}
>
	<section class="section dense-summary">
		<p class="eyebrow">Post-DevCon 5 Findings</p>
		<h1>Public surface area expanded beyond the original OSDK story.</h1>
		<p class="lede">
			Net-new signals include a real ontology-as-code DSL, a visible compiler/backend rewrite,
			preview converter/generator bridges, local function-testing helpers, thin AI proxy helpers,
			and adjacent Python runtime/connectivity libraries. The sharpest unresolved seam is still
			Maker's dependency on private TypeScript discovery.
		</p>
		<div class="meta-row">
			<span>{packages.length} packages tracked</span>
			<span>{seams.length} seam patterns</span>
			<span>technical audience / low-commentary view</span>
		</div>
	</section>

	<section class="section">
		<div class="section-header">
			<div>
				<p class="eyebrow">Newest first</p>
				<h2>Recent public additions</h2>
			</div>
			<a class="link-arrow" href="/timeline">Full timeline -></a>
		</div>
		<ul class="timeline-list">
			{recentPackages.map((entry) => {
				const meta = packageMeta[entry.id];
				return (
					<li>
						<strong>{entry.data.firstSeen} · {entry.data.packageName}</strong>
						<div>{entry.data.summary}</div>
						<div class="meta-row">
							<StatusPill status={entry.data.status} />
							{meta?.inspectedVersion && <span>inspected {meta.inspectedVersion}</span>}
							<a class="link-arrow" href={`/packages/${entry.id}`}>details -></a>
						</div>
					</li>
				);
			})}
		</ul>
	</section>

	<section class="section">
		<div class="section-header">
			<div>
				<p class="eyebrow">Inventory</p>
				<h2>Tracked packages</h2>
			</div>
			<a class="link-arrow" href="/packages">Inventory view -></a>
		</div>
		<div class="table-wrap">
			<table class="dense-table">
				<thead>
					<tr>
						<th>First seen</th>
						<th>Package</th>
						<th>Inspected</th>
						<th>Status</th>
						<th>Why it matters</th>
						<th>Links</th>
					</tr>
				</thead>
				<tbody>
					{packages.map((entry) => {
						const meta = packageMeta[entry.id] ?? {};
						return (
							<tr>
								<td class="mono">{entry.data.firstSeen}</td>
								<td>
									<a href={`/packages/${entry.id}`}>{entry.data.packageName}</a>
									<div class="table-subtle">{entry.data.kind}</div>
								</td>
								<td class="mono">{meta.inspectedVersion ?? '-'}</td>
								<td><StatusPill status={entry.data.status} /></td>
								<td>{entry.data.summary}</td>
								<td>
									<div class="table-links">
										{meta.registryUrl && <a href={meta.registryUrl} target="_blank" rel="noreferrer">{meta.registryLabel ?? 'registry'}</a>}
										{meta.repoUrl && <a href={meta.repoUrl} target="_blank" rel="noreferrer">repo</a>}
										{meta.codeUrl && <a href={meta.codeUrl} target="_blank" rel="noreferrer">code</a>}
									</div>
								</td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	</section>

	<section class="section">
		<div class="section-header">
			<div>
				<p class="eyebrow">Seams</p>
				<h2>Highest-signal boundary issues</h2>
			</div>
			<a class="link-arrow" href="/seams">All seams -></a>
		</div>
		<div class="card-grid compact-grid">
			{seams.map((entry) => (
				<article class="card span-4 compact-card">
					<StatusPill status={entry.data.status} />
					<h3>{entry.data.title}</h3>
					<p>{entry.data.summary}</p>
					<p><a class="link-arrow" href={`/seams/${entry.id}`}>detail -></a></p>
				</article>
			))}
		</div>
	</section>
</SiteShell>
