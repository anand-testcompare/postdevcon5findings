---
import { getCollection } from 'astro:content';
import SiteShell from '../layouts/SiteShell.astro';
import StatusPill from '../components/StatusPill.astro';
import { homepageHighlights, importanceOrder, workflowSteps } from '../data/research';
import { compareFirstSeenDesc, comparePackagePriority, packageMeta } from '../data/packageMeta';

const timelinePackages = (await getCollection('packages')).sort(
	(a, b) =>
		compareFirstSeenDesc(a.data.firstSeen, b.data.firstSeen)
		|| importanceOrder[a.data.importance] - importanceOrder[b.data.importance],
);
const packages = [...timelinePackages].sort((a, b) => comparePackagePriority(a, b, importanceOrder));
const seams = await getCollection('seams');
const corePackages = packages.slice(0, 6);
---

<SiteShell
	title="Post-DevCon 5 Findings"
	description="A research atlas of Palantir's public OSDK, compiler, and private-boundary signals."
	showHero={false}
>
	<section class="section dense-summary">
		<p class="eyebrow">Post-DevCon 5 Findings</p>
		<h1>DevCon 5 surfaced a broader public compiler stack, not just a bigger SDK.</h1>
		<p class="lede">
			The important read is where the public graph now exposes actual generation and compile boundaries:
			Maker, Maker Experimental, preview converters, OAC wrappers, and the still-unresolved private
			TypeScript discovery seam.
		</p>
		<div class="meta-row">
			<span>{packages.length} packages tracked</span>
			<span>{seams.length} seam patterns</span>
			<span>priority-first package ordering</span>
			<span>technical audience / low-commentary view</span>
		</div>
	</section>

	<section class="section">
		<div class="card-grid compact-grid">
			<article class="card span-6 compact-card">
				<p class="eyebrow">Key claims</p>
				<ul class="plain-list compact-list single-column-list">
					{homepageHighlights.slice(0, 4).map((item) => <li class="list-card">{item}</li>)}
				</ul>
			</article>
			<article class="card span-6 compact-card">
				<p class="eyebrow">Working model</p>
				<ul class="plain-list compact-list single-column-list">
					{workflowSteps.map((step) => (
						<li class="list-card">
							<strong>{step.title}</strong>
							<div>{step.detail}</div>
						</li>
					))}
				</ul>
			</article>
		</div>
	</section>

	<section class="section">
		<div class="section-header">
			<div>
				<p class="eyebrow">Read first</p>
				<h2>Highest-signal packages</h2>
			</div>
			<a class="link-arrow" href="/packages">Full inventory -></a>
		</div>
		<ul class="timeline-list">
			{corePackages.map((entry) => {
				const meta = packageMeta[entry.id];
				return (
					<li>
						<strong>{entry.data.packageName}</strong>
						<div>{entry.data.summary}</div>
						<div class="meta-row">
							<span>{entry.data.importance} signal</span>
							<span>first seen {entry.data.firstSeen}</span>
							<StatusPill status={entry.data.status} />
							{meta?.inspectedVersion && <span>inspected {meta.inspectedVersion}</span>}
							<a class="link-arrow" href={`/packages/${entry.id}`}>details -></a>
						</div>
					</li>
				);
			})}
		</ul>
	</section>

	<section class="section">
		<div class="section-header">
			<div>
				<p class="eyebrow">Inventory</p>
				<h2>Tracked packages</h2>
			</div>
			<a class="link-arrow" href="/packages">Inventory view -></a>
		</div>
		<div class="table-wrap">
			<table class="dense-table">
				<thead>
					<tr>
						<th>Priority</th>
						<th>Package</th>
						<th>First seen</th>
						<th>Inspected</th>
						<th>Latest stable</th>
						<th>Status</th>
						<th>Why it matters</th>
						<th>Links</th>
					</tr>
				</thead>
				<tbody>
					{packages.map((entry) => {
						const meta = packageMeta[entry.id] ?? {};
						return (
							<tr>
								<td class="mono">{entry.data.importance}</td>
								<td>
									<a href={`/packages/${entry.id}`}>{entry.data.packageName}</a>
									<div class="table-subtle">{entry.data.kind}</div>
								</td>
								<td class="mono">{entry.data.firstSeen}</td>
								<td class="mono">{meta.inspectedVersion ?? '-'}</td>
								<td class="mono">{meta.latestReleaseVersion ?? '-'}</td>
								<td><StatusPill status={entry.data.status} /></td>
								<td>{entry.data.summary}</td>
								<td>
									<div class="table-links">
										{meta.registryUrl && <a href={meta.registryUrl} target="_blank" rel="noreferrer">{meta.registryLabel ?? 'registry'}</a>}
										{meta.latestReleaseUrl && meta.latestReleaseUrl !== meta.registryUrl && <a href={meta.latestReleaseUrl} target="_blank" rel="noreferrer">latest</a>}
										{meta.repoUrl && <a href={meta.repoUrl} target="_blank" rel="noreferrer">source</a>}
										{meta.sourceUrl && <a href={meta.sourceUrl} target="_blank" rel="noreferrer">file</a>}
									</div>
								</td>
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	</section>

	<section class="section">
		<div class="section-header">
			<div>
				<p class="eyebrow">Seams</p>
				<h2>Highest-signal boundary issues</h2>
			</div>
			<a class="link-arrow" href="/seams">All seams -></a>
		</div>
		<div class="card-grid compact-grid">
			{seams.map((entry) => (
				<article class="card span-4 compact-card">
					<StatusPill status={entry.data.status} />
					<h3>{entry.data.title}</h3>
					<p>{entry.data.summary}</p>
					<p><a class="link-arrow" href={`/seams/${entry.id}`}>detail -></a></p>
				</article>
			))}
		</div>
	</section>
</SiteShell>
