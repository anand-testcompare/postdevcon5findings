---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav class="site-nav">
		<div class="brand-lockup">
			<p class="eyebrow">Research Atlas</p>
			<h2><a href="/">{SITE_TITLE}</a></h2>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Overview</HeaderLink>
			<HeaderLink href="/timeline">Timeline</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1.25rem;
		backdrop-filter: blur(18px);
		background: rgba(23, 28, 34, 0.92);
		border-bottom: 1px solid var(--border-color);
	}
	h2 {
		margin: 0;
		font-size: 1.05rem;
	}
	h2 a {
		text-decoration: none;
		color: var(--ink-strong);
	}
	.brand-lockup {
		display: grid;
		gap: 0.1rem;
	}
	.eyebrow {
		margin: 0;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent-strong);
	}
	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4.75rem;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.35rem;
	}
	.internal-links :global(a) {
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		color: var(--ink-muted);
		text-decoration: none;
	}
	.internal-links :global(a.active) {
		background: rgba(105, 209, 47, 0.12);
		color: var(--ink-strong);
	}
	@media (max-width: 900px) {
		.site-nav {
			align-items: flex-start;
			padding: 0.85rem 0;
			flex-direction: column;
		}
		.internal-links {
			justify-content: flex-start;
		}
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		.internal-links :global(a) {
			padding: 0.45rem 0.75rem;
		}
	}
</style>
