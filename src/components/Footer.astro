---
const today = new Date();
import { REPO_URL } from '../consts';
---

<footer>
	<div class="footer-copy">
		<p>Post-DevCon 5 Findings tracks the newer public OSDK/compiler packages, seams, versions, and code pointers.</p>
		<p>&copy; {today.getFullYear()} Technical notes for fast review.</p>
	</div>
	<div class="footer-links">
		<a href="/packages">Packages</a>
		<a href="/timeline">Timeline</a>
		<a href={REPO_URL} target="_blank" rel="noreferrer">GitHub</a>
	</div>
</footer>
<style>
	footer {
		padding: 2.5rem 1rem 4rem;
		border-top: 1px solid var(--border-color);
		background: color-mix(in srgb, var(--surface-strong) 60%, white 40%);
		color: var(--ink-muted);
		text-align: center;
	}
	.footer-copy {
		max-width: 52rem;
		margin: 0 auto;
	}
	.footer-copy p {
		margin: 0.35rem 0;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1.25rem;
		flex-wrap: wrap;
	}
	.footer-links a {
		text-decoration: none;
		color: var(--ink-strong);
	}
	.footer-links a:hover {
		color: var(--accent-strong);
	}
</style>
